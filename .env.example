NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # Obtener en: Supabase Dashboard → Settings → API → service_role

NEXT_PUBLIC_VAPID_PUBLIC_KEY=...   # Generado con: node -e "require('web-push').generateVAPIDKeys()"
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:tu@email.com

CRON_SECRET=...   # Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
                   # Vercel envía este valor como "Authorization: Bearer <CRON_SECRET>" al invocar
                   # el cron de /api/cron/limpiar-fotos (ver vercel.json). Configurar en Vercel →
                   # Project Settings → Environment Variables (Production).
